generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum SubscriptionStatus {
  active
  expired
  canceled
  pending
}

enum ActivityType {
  payment
  subscription
}

enum ActivityStatus {
  Completed
  Pending
}

enum PaymentStatus {
  pending
  success
  failed
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  whatsapp     String         @unique
  passwordHash String
  role         Role           @default(user)
  avatar       String?
  emailVerified Boolean       @default(false)
  emailVerificationCode String?
  emailVerificationExpires DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions      Subscription[]
  activities         Activity[]
  payments           Payment[]
  passwordResetTokens PasswordResetToken[]
}

model Service {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  price       Int
  icon        String
  bg          String
  description String
  features    String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  subscriptions Subscription[]
  payments     Payment[]
}

model Subscription {
  id           String              @id @default(cuid())
  userId       String
  serviceId    String
  status       SubscriptionStatus  @default(pending)
  price        Int
  months       Int                 @default(1)
  icon         String
  bg           String
  activeDate   DateTime?
  durationDays Int?
  nextBilling  DateTime?
  welcomeEmailSentAt DateTime?
  reminder3dSentAt   DateTime?
  expiryNoticeSentAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@unique([userId, serviceId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  serviceId         String
  subscriptionId    String?
  reference         String        @unique
  gateway           String        @default("paystack")
  amount            Int
  months            Int           @default(1)
  status            PaymentStatus @default(pending)
  authorizationUrl  String?
  accessCode        String?
  paystackResponse  Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([serviceId])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Activity {
  id        String         @id @default(cuid())
  userId    String
  type      ActivityType
  service   String
  amount    String
  status    ActivityStatus
  date      String
  icon      String
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

enum FamilySlotStatus {
  vacant
  occupied
  expired
}

model FamilyAccount {
  id             String   @id @default(cuid())
  label          String
  serviceName    String
  masterEmail    String
  masterPassword String?
  capacity       Int      @default(6)
  monthlyCost    Int?
  renewalDate    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  slots          FamilySlot[]

  @@index([serviceName])
}

model FamilySlot {
  id              String           @id @default(cuid())
  familyAccountId String
  slotNumber      Int
  memberName      String?
  memberEmail     String?
  memberContact   String?
  status          FamilySlotStatus @default(vacant)
  startDate       DateTime?
  expireDate      DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  familyAccount FamilyAccount @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)

  @@unique([familyAccountId, slotNumber])
  @@index([familyAccountId])
  @@index([status])
}
