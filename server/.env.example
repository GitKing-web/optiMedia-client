PORT=3000
# Comma-separated list of allowed client origins (for CORS)
CORS_ORIGINS=http://localhost:3001,https://optimedia-client.onrender.com
# Use a long random secret (at least 16 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
DATABASE_URL=
CLIENT_URL=http://localhost:3001
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
